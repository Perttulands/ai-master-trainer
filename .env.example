# ============================================
# RUNTIME CONFIGURATION (Required for Training Camp)
# ============================================

# Runtime mode:
# - litellm: frontend calls LiteLLM directly (default)
# - adk: frontend calls backend ADK runtime
VITE_LLM_RUNTIME=litellm

# LiteLLM Gateway - All runtime LLM calls go through this
# Default: https://app-litellmsn66ka.azurewebsites.net (hardcoded in llm.ts)
# Override with your own gateway if needed:
# VITE_LITELLM_API_BASE=https://your-litellm-proxy.com
VITE_LITELLM_API_KEY=your_litellm_api_key_here
VITE_LITELLM_MODEL=anthropic/claude-4-5-sonnet-aws

# ADK Runtime (used when VITE_LLM_RUNTIME=adk)
VITE_ADK_RUNTIME_BASE=http://localhost:8000
# Optional if your ADK service requires auth:
# VITE_ADK_RUNTIME_API_KEY=your_adk_service_token

# Orchestration mode:
# - local: browser-local sql.js orchestration (default)
# - backend: session/directives/history/run/evaluate/iterate via ADK backend API
VITE_ORCHESTRATION_MODE=local
# Optional override (defaults to VITE_ADK_RUNTIME_BASE):
# VITE_ORCHESTRATION_API_BASE=http://localhost:8000

# ============================================
# EXPORTED CODE ONLY (Not used by Training Camp runtime)
# ============================================

# Only needed if you export agents to run standalone outside Training Camp
# The exported TypeScript code uses Anthropic SDK directly
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ============================================
# DEVELOPMENT SETTINGS
# ============================================

NODE_ENV=development
